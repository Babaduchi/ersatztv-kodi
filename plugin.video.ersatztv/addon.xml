<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.ersatztv" name="ErsatzTV" version="2.3.7" provider-name="Babaduchi">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Watch ErsatzTV channels with a native Kodi interface</summary>
    <description lang="en_GB">Browse and manage ErsatzTV, start a local server, and automatically configure IPTV Simple Client and Kodi PVR options for Live TV.</description>
    <platform>all</platform>
    <license>MIT</license>
    <website>https://ersatztv.org/</website>
    <source>https://github.com/ErsatzTV/ErsatzTV</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
